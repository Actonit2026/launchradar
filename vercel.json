{
  "framework": "nextjs",
  "buildCommand": "next build",
  "outputDirectory": ".next",
  "installCommand": "npm install",
  "crons": [
    {
      "path": "/api/scan",
      "schedule": "0 */12 * * *"
    }
  ],
  "functions": {
    "src/app/api/scan/route.ts": {
      "maxDuration": 60
    },
    "src/app/api/baseline/route.ts": {
      "maxDuration": 300
    }
  }
}
